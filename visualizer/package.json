    "@types/d3-zoom": "3.0.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "d3-geo": "3.1.1",
    "mapshaper": "0.7.81",
